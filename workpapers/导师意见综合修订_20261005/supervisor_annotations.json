[
  {
    "page": 1,
    "text": {
      "content": "从仿真到现实的公交系统驻站控制方法研究\r",
      "name": "Comment",
      "title": "Liang",
      "creationDate": "D:20260929170940+08'00'",
      "modDate": "D:20260929171304+08'00'",
