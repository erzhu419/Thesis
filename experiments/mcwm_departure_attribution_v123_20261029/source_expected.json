ine_id_s, bus_id, stop_id)", "            if key in self.pending_events:", "                continue", "            arrive_time, predicted_depart_time = bus_obj.just_server_stop_data_d[stop_id]", "            base_duration = max(predicted_depart_time - arrive_time, 0.0)", "            service_completion_time = arrive_time + base_duration", "", "            # Protect the full passenger-exchange interval immediately on", "            # arrival. Waiting until the decision time lets a one-slot station", "            # or the route's shorter default stop release the bus early.", "            if key not in self._protected_base_service_visits:", "                try:", "                    traci.vehicle.setStopParameter(", "                        bus_id,", "                        0,", "                        \"duration\",", "                        \"3600.0\",", "                    )", "                except traci.TraCIException as error:", "                    raise RuntimeError(", "                        f\"failed to protect base service for {bus_id} at {stop_id}\"", "                    ) from error", "                self._protected_base_service_visits.add(key)", "            ", "            # Timing Alignment: Only process if passenger exchange is done", "            # This ensures we observe the state AFTER passengers have boarded/alighted, matching original logic", "            if simulation_current_time < service_completion_time:", "                continue", "", "            # Prevent duplicate events for the same stop visit", "            if getattr(bus_obj, 'last_action_time', -1.0) == arrive_time:", "                continue", "            bus_obj.last_action_time = arrive_time", ""]}, {"path": "experiments/mcwm_bus/runtime/H2Oplus/bus_h2o/sumo_env/rl_bridge.py", "low": 1476, "high": 1488, "lines": ["            # Pre-emptive Holding:", "            # Immediately set a large duration to keep the stop active in SUMO while the agent decides.", "            