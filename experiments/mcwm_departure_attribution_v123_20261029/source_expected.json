[{"path": "experiments/mcwm_bus/runtime/H2Oplus/bus_h2o/sumo_env/rl_bridge.py", "low": 65, "high": 69, "lines": ["", "class SumoRLBridge:", "    ALIGHTING_SERVICE_SECONDS_PER_PASSENGER = 1.5", "    BOARDING_SERVICE_SECONDS_PER_PASSENGER = 2.5", ""]}, {"path": "experiments/mcwm_bus/runtime/H2Oplus/bus_h2o/sumo_env/rl_bridge.py", "low": 366, "high": 387, "lines": ["    def _configure_sumo_bus_service_durations(self) -> None:", "        configured = {}", "        for type_id in traci.vehicletype.getIDList():", "            if traci.vehicletype.getVehicleClass(type_id) != \"bus\":", "                continue", "            traci.vehicletype.setBoardingDuration(", "                type_id, self.BOARDING_SERVICE_SECONDS_PER_PASSENGER", "            )", "            observed = float(traci.vehicletype.getBoardingDuration(type_id))", "            if not np.isclose(", "                observed,", "                self.BOARDING_SERVICE_SECONDS_PER_PASSENGER,", "                rtol=0.0,", "                atol=1e-9,", "            ):", "                raise RuntimeError(", "                    f\"SUMO bus type {type_id} retained boarding duration {observed}\"", "                )", "            configured[str(type_id)] = observed", "        if not configured:", "            raise RuntimeError(\"SUMO configuration contains no bus vehicle type\")", "        self._sumo_bus_type_boarding_durations = configured"]}, {"path": "experiments/mcwm_bus/runtime/H2Oplus/bus_h2o/sumo_env/rl_bridge.py", "low": 955, "high": 992, "lines": ["        service_completion_time = float(", "            event.metadata.get(", "                'service_completion_time',", "                float(event.metadata['arrive_time'])", "                + float(event.base_stop_duration),", "            )", "        )", "        ", "        try:", "            # Physics Override Fix: setMaxSpeed only caps the vehicle mechanically,", "            # but remains bounded by the lane's physical speed limit.", "        